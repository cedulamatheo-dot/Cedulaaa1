<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IT Portfolio Lab 3</title>
  <style>
    /* Basic reset */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6fa;
      color: #222;
      line-height: 1.5;
      padding: 20px;
    }

    /* Container */
    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    /* Header */
    .header {
      background: #ffffff;
      border: 2px solid #d0d7de;
      padding: 18px;
      margin-bottom: 18px;
      border-radius: 8px;
      text-align: center;
      box-shadow: 0 4px 12px rgba(107, 70, 193, 0.08);
    }

    .header h1 {
      letter-spacing: 1px;
      font-size: 1.6rem;
    }

    /* Blue to Purple Gradient Highlight Text */
    .highlight {
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-weight: 600;
    }

    /* Main layout */
    .main-area {
      display: flex;
      gap: 20px;
      align-items: flex-start;
    }

    /* Content */
    .content {
      flex: 2;
      background: #fff;
      border: 1px solid #e0e6ea;
      padding: 16px;
      border-radius: 6px;
    }

    /* Sidebar */
    .sidebar {
      flex: 1;
      background: #fff;
      border: 1px solid #e0e6ea;
      padding: 16px;
      border-radius: 6px;
    }

    .sidebar h3 {
      color: #4c1d95;
      margin-bottom: 8px;
    }

    .sidebar ul {
      list-style: none;
    }

    .sidebar li {
      margin-bottom: 6px;
    }

    .sidebar a {
      color: #2563eb;
      text-decoration: none;
      font-weight: 500;
    }

    .sidebar a:hover {
      color: #7c3aed;
      text-decoration: underline;
    }

    /* Profile card */
    .profile-card {
      display: flex;
      gap: 16px;
      align-items: center;
      border: 2px dashed #c084fc;
      padding: 12px;
      margin-bottom: 14px;
      background: #fdfaff;
      border-radius: 6px;
    }

    .avatar {
      width: 96px;
      height: 96px;
      object-fit: cover;
      border-radius: 6px;
      border: 3px solid #60a5fa;
    }

    /* Gradient Button */
    .contact-btn {
      margin-top: 8px;
      padding: 8px 14px;
      border: none;
      border-radius: 4px;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      color: white;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .contact-btn:hover {
      opacity: 0.9;
    }

    /* Footer */
    .footer {
      text-align: center;
      margin-top: 16px;
      padding: 10px;
      font-size: 0.9rem;
      color: #555;
    }

    /* Responsive layout */
    @media (max-width: 700px) {
      .main-area {
        flex-direction: column;
      }
      
      .avatar {
        width: 72px;
        height: 72px;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    
    <!-- Header -->
    <header class="header">
      <h1>IT Portfolio <span class="highlight">Lab 3</span></h1>
    </header>

    <!-- Main Layout Area -->
    <main class="main-area">
      
      <!-- Content (Left Column) -->
      <section class="content">
        <div class="profile-card">
          <img class="avatar" src="data:image/jpeg;base64," alt="Profile Picture">
          <div class="profile-info">
            <h2>Matheo Charles Yuan D Cedula</h2>
            <p><strong>Role:</strong> Web Developer</p>
            <p>Passionate about building <span class="highlight">responsive</span>, user-friendly web applications.</p>
            <button class="contact-btn">Contact Me</button>
          </div>
        </div>

        <p>Welcome to my portfolio lab assignment. This section demonstrates responsive web design principles using modern CSS layouts including Flexbox and media queries.</p>
      </section>

      <!-- Sidebar (Right Column) -->
      <aside class="sidebar">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="#">Projects</a></li>
          <li><a href="#">Resume</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </aside>

    </main>

    <!-- Footer -->
    <footer class="footer">
      <p>&copy; 2025 — CSIT Lab</p>
    </footer>

  </div>

</body>
</html>
